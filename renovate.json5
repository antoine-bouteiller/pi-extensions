{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  dependencyDashboard: false,
  extends: [
    'config:recommended',
    ':disableRateLimiting',
    ':ignoreUnstable',
    'helpers:pinGitHubActionDigestsToSemver',
    'antoine-bouteiller/pi-extensions//.renovate/auto-merge.json5',
    'antoine-bouteiller/pi-extensions//.renovate/groups.json5',
    'antoine-bouteiller/pi-extensions//.renovate/semantic-commits.json5',
  ],
  ignorePresets: ['mergeConfidence:all-badges'],
  configMigration: true,
  minimumReleaseAge: '1 day',
  gitIgnoredAuthors: ['41898282+github-actions[bot]@users.noreply.github.com'],
  labels: ['renovate'],
  packageRules: [
    {
      description: 'Effect is pinned to an exact beta for the duration of the v4 rewrite (.plan/effect-v4-rewrite). Re-enable once the rewrite lands.',
      matchPackageNames: ['effect', '@effect/**'],
      enabled: false,
    },
  ],
  'pre-commit': {
    enabled: true,
  },
}
