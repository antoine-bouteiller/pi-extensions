{
  "name": "pi-extensions",
  "version": "0.1.0",
  "description": "First-party extensions for Pi, distributed as a single installable Pi package.",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "imports": {
    "#features/*": "./src/features/*.ts",
    "#config/*": "./src/config/*.ts",
    "#shared/*": "./src/shared/*.ts",
    "#tests/*": "./tests/*.ts"
  },
  "scripts": {
    "prepare": "command -v effect-tsgo >/dev/null 2>&1 || exit 0; effect-tsgo patch --no-typescript --oxlint",
    "fmt:check": "bun fmt --check",
    "knip": "knip",
    "knip:production": "knip --production",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "test": "bun test tests/ && node --test oxlint/rules/*.test.ts",
    "test:coverage": "bun test tests/ --coverage --reporter=junit --reporter-outfile=./junit.xml && node --test oxlint/rules/*.test.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.7",
    "@oh-my-pi/hashline": "18.1.5",
    "effect": "4.0.7"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@effect/tsgo": "0.56.0",
    "@oxlint/plugins": "1.89.0",
    "@types/bun": "1.4.4",
    "knip": "6.43.0",
    "lefthook": "^2.1.10",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typebox": "1.4.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.7"
  },
  "packageManager": "bun@1.4.4",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
