{
  "name": "pi-extensions",
  "version": "0.1.0",
  "description": "First-party extensions for Pi, distributed as a single installable Pi package.",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "imports": {
    "#features/*": "./src/features/*.ts",
    "#config/*": "./src/config/*.ts",
    "#shared/*": "./src/shared/*.ts",
    "#tests/*": "./tests/*.ts"
  },
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "check": "bun run fmt:check && bun run lint && bun run knip && bun run test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "test": "bun test tests/ && node --test oxlint/rules/*.test.ts",
    "test:coverage": "bun test tests/ --coverage --reporter=junit --reporter-outfile=./junit.xml && node --test oxlint/rules/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.112",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@napi-rs/keyring": "2.0.0",
    "@oh-my-pi/hashline": "18.1.0",
    "effect": "4.0.0-rc.112",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@effect/language-service": "0.87.2",
    "@effect/tsgo": "0.39.0",
    "@oxlint/plugins": "1.80.0",
    "@types/bun": "1.4.0",
    "@types/node": "26.4.0",
    "@types/turndown": "5.0.6",
    "knip": "6.34.0",
    "lefthook": "^2.1.10",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typebox": "1.3.24",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "packageManager": "bun@1.4.0",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
