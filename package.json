{
  "name": "pi-extensions",
  "version": "0.1.0",
  "description": "First-party extensions for Pi, distributed as a single installable Pi package.",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "check": "bun run fmt:check && bun run lint && bun run knip && bun run test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "test": "bun test",
    "test:coverage": "bun test --coverage --reporter=junit --reporter-outfile=./junit.xml",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.108",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@napi-rs/keyring": "1.3.0",
    "@oh-my-pi/hashline": "17.3.3",
    "effect": "4.0.0-rc.108",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@effect/language-service": "0.87.2",
    "@effect/tsgo": "0.36.4",
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "@types/turndown": "5.0.6",
    "knip": "6.32.2",
    "lefthook": "^2.1.10",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "typebox": "1.3.13",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "packageManager": "bun@1.3.14",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
