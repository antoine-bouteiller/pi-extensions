{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  packageRules: [
    {
      description: 'Oxc Group',
      groupName: 'oxc',
      matchPackageNames: ['oxlint', 'oxlint-tsgolint', '@oxlint/plugins', '@effect/tsgo'],
    },
    {
      description: 'Pi Coding Agent Group',
      groupName: 'pi-agent',
      matchPackageNames: ['@earendil-works/*'],
    },
    {
      description: 'Effect Group',
      groupName: 'effect',
      matchPackageNames: ['effect', '@effect/**', '!@effect/tsgo'],
    },
    {
      description: 'Bun Group',
      groupName: 'bun',
      matchPackageNames: ['bun', 'oven-sh/bun', '@types/bun'],
    },
  ],
}
