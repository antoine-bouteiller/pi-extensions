{
  "name": "pi-extensions",
  "version": "0.1.0",
  "description": "First-party extensions for Pi, distributed as a single installable Pi package.",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "imports": {
    "#test-utils/*": "./test/utils/*.ts"
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run knip && bun run test",
    "knip": "knip",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "test": "bun test",
    "test:coverage": "bun test --coverage --reporter=junit --reporter-outfile=./junit.xml",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@napi-rs/keyring": "1.3.0",
    "@oh-my-pi/hashline": "17.2.4",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.2",
    "@types/turndown": "5.0.6",
    "knip": "6.31.0",
    "lefthook": "^2.1.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typebox": "1.3.9",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "packageManager": "bun@1.3.14",
  "pi": {
    "extensions": [
      "./extension.ts"
    ]
  }
}
